NODE_ENV=production

# Public routing. The web build uses a relative API path behind Nginx.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_URL=https://vrompt.example.com
WEB_ORIGIN=https://vrompt.example.com
AI_API_BASE_URL=https://api.openai.com/v1
# Store this only in the API environment; never send it to the browser.
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT_MS=60000
AI_PUBLIC_GUEST_DAILY_LIMIT=3
AI_PUBLIC_FREE_DAILY_LIMIT=10
AI_PUBLIC_PREMIUM_DAILY_LIMIT=100
AI_INTERNAL_DAILY_LIMIT=50
AI_MAX_OUTPUT_TOKENS=1600
AI_RATE_LIMIT_PER_MINUTE=5
AI_CONTENT_GAP_THRESHOLD=3
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=live
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
PAYMONGO_PRO_PRICE_CENTAVOS=29900
PAYMONGO_PRO_PERIOD_DAYS=30
PAYMONGO_CHECKOUT_EXPIRY_HOURS=24
VROMPT_DOMAIN=vrompt.example.com
VROMPT_LETSENCRYPT_DIR=/etc/letsencrypt
VROMPT_TLS_CERT_PATH=/etc/letsencrypt/live/vrompt.example.com/fullchain.pem
VROMPT_TLS_KEY_PATH=/etc/letsencrypt/live/vrompt.example.com/privkey.pem

# Database and cache
POSTGRES_DB=vrompt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://vrompt.example.com/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://vrompt.example.com/api/v1/auth/github/callback
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
MODERATOR_BOOTSTRAP_EMAIL=
MODERATOR_BOOTSTRAP_USERNAME=
MODERATOR_BOOTSTRAP_PASSWORD=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Evidence storage. Cloudinary is external to Docker.
MEDIA_STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
