generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum AccountType {
  REAL
  STARTER
  OFFICIAL
}

enum MembershipPlan {
  FREE
  PRO
}

enum BillingProvider {
  PAYMONGO
}

enum BillingPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  REQUIRES_ACTION
}

enum BillingSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
  ONE_TIME
}

enum UsageResetPeriod {
  DAILY
  MONTHLY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionMode {
  AUTOMATIC
  CODE
}

enum PromptOrigin {
  COMMUNITY
  AI_GENERATED
  IMPORTED
}

enum AiGenerationMode {
  PUBLIC
  INTERNAL
}

enum AiGenerationOperation {
  GENERATE
  REGENERATE
  IMPROVE
  EXPAND
  SHORTEN
}

enum AiGenerationStatus {
  REQUESTED
  SUCCEEDED
  FAILED
  REJECTED
}

enum PromptVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PromptRepositoryStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum PromptVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum CollectionVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  NEW_FOLLOWER
  PROMPT_LIKED
  PROMPT_COMMENTED
  COMMENT_REPLIED
  VARIANT_CREATED
}

enum ReportTargetType {
  REPOSITORY
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  SCAM
  MISLEADING
  MISLEADING_EVIDENCE
  COPYRIGHT
  HARASSMENT
  UNSAFE_CONTENT
  ADULT_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  RESOLVED
}

enum ModerationTargetType {
  REPOSITORY
  COMMENT
  USER
}

enum ModerationActionType {
  HIDE_REPOSITORY
  RESTORE_REPOSITORY
  HIDE_COMMENT
  RESTORE_COMMENT
  SUSPEND_USER
  RESTORE_USER
}

enum AuditTargetType {
  MODEL
  GENERATION_POLICY
  REPOSITORY
  COMMENT
  USER
  REPORT
  ROLE
  AUDIENCE
  SETTING
  GENERATION
  BILLING_PAYMENT
  BILLING_SUBSCRIPTION
  BILLING_WEBHOOK
}

enum AuditActionType {
  MODEL_CONFIGURED
  GENERATION_POLICY_CONFIGURED
  PROMPT_HIDDEN
  PROMPT_RESTORED
  COMMENT_HIDDEN
  USER_SUSPENDED
  USER_RESTORED
  ROLE_CHANGED
  REPORT_RESOLVED
  AUDIENCE_CREATED
  AUDIENCE_UPDATED
  AUDIENCE_ACTIVATED
  AUDIENCE_DEACTIVATED
  AUDIENCE_REORDERED
  SETTING_UPDATED
  SETTING_RESET
  AI_GENERATION_DRAFTED
  AI_GENERATION_REJECTED
  AI_GENERATION_PUBLISHED
  BILLING_CHECKOUT_CREATED
  BILLING_PAYMENT_CONFIRMED
  BILLING_PAYMENT_FAILED
  BILLING_PRO_ACTIVATED
  BILLING_PRO_EXPIRED
  BILLING_PAYMENT_REFUNDED
  BILLING_WEBHOOK_REJECTED
  BILLING_WEBHOOK_DUPLICATE
  BILLING_PLAN_CHANGED
}

enum ActivityType {
  REPOSITORY_CREATED
  VERSION_PUBLISHED
  VARIANT_CREATED
  COLLECTION_CREATED
}

model User {
  guestKey String? @unique @db.VarChar(64)
  guestExpiresAt DateTime?
  projects Project[]
  id                  String         @id @default(uuid()) @db.Uuid
  email               String         @unique @db.VarChar(320)
  username            String         @unique @db.VarChar(32)
  role                UserRole       @default(USER)
  status              UserStatus     @default(ACTIVE)
  accountType         AccountType    @default(REAL)
  plan                MembershipPlan @default(FREE)
  onboardingCompleted Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  profile              Profile?
  identities           UserIdentity[]
  staffCredential      StaffCredential?
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  settingUpdates       SiteSetting[]
  billingSubscriptions BillingSubscription[]
  billingPayments      BillingPayment[]
  usageBuckets         FeatureUsageBucket[]
  usageEvents          FeatureUsageEvent[]
  promotionRedemptions PromotionRedemption[]
  conversations        Conversation[]
  savedPrompts         SavedPrompt[]
  chatReservations     QuotaReservation[]
  chatCounters         UsageCounter[]
  chatUsage            UsageRecord[]
  attachments          Attachment[]

  @@index([status, createdAt])
}

model SiteSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  group       String   @db.VarChar(40)
  isPublic    Boolean  @default(false)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group, key])
}

model StaffCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @db.Uuid
  passwordHash String    @db.VarChar(255)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserIdentity {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  provider         OAuthProvider
  providerUserId   String        @db.VarChar(255)
  providerEmail    String?       @db.VarChar(320)
  providerUsername String?       @db.VarChar(255)
  avatarUrl        String?       @db.VarChar(500)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId, provider])
}

model Profile {
  preferences Json @default("{}")
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String?  @db.VarChar(80)
  bio         String?  @db.Text
  avatar      String?  @db.VarChar(500)
  website     String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model BillingSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String                    @db.Uuid
  plan                   MembershipPlan            @default(PRO)
  planConfigId           String?                   @db.Uuid
  provider               BillingProvider
  status                 BillingSubscriptionStatus @default(PENDING)
  externalSubscriptionId String?                   @unique @db.VarChar(255)
  externalCustomerId     String?                   @db.VarChar(255)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  canceledAt             DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planConfig BillingPlan?     @relation(fields: [planConfigId], references: [id], onDelete: Restrict)
  payments   BillingPayment[]

  @@index([userId, status, currentPeriodEnd])
  @@index([provider, status, currentPeriodEnd])
}

model BillingPayment {
  id                        String               @id @default(uuid()) @db.Uuid
  userId                    String               @db.Uuid
  subscriptionId            String?              @db.Uuid
  provider                  BillingProvider
  plan                      MembershipPlan
  planConfigId              String?              @db.Uuid
  promotionId               String?              @db.Uuid
  status                    BillingPaymentStatus @default(PENDING)
  amount                    Int
  originalAmount            Int                  @default(0)
  discountAmount            Int                  @default(0)
  currency                  String               @db.Char(3)
  discountCodeId            String?              @db.Uuid
  idempotencyKey            String               @unique @db.VarChar(255)
  externalCheckoutSessionId String?              @unique @db.VarChar(255)
  externalPaymentIntentId   String?              @unique @db.VarChar(255)
  externalPaymentId         String?              @unique @db.VarChar(255)
  failureCode               String?              @db.VarChar(100)
  metadata                  Json?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  paidAt                    DateTime?

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planConfig   BillingPlan?         @relation(fields: [planConfigId], references: [id], onDelete: Restrict)
  promotion    Promotion?           @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  redemption   PromotionRedemption?
  discountCode DiscountCode?        @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([subscriptionId, status])
  @@index([provider, status, createdAt])
  @@index([discountCodeId, status, createdAt])
}

model BillingPlan {
  monthlyCredits Int @default(100)
  maxProjects Int @default(0)
  maxWorkflows Int @default(0)
  maxWorkflowSteps Int @default(5)
  projectContextChars Int @default(8000)
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @unique @db.VarChar(50)
  legacyPlan      MembershipPlan?
  name            String          @db.VarChar(100)
  description     String          @db.Text
  originalPrice   Int
  currency        String          @default("USD") @db.Char(3)
  billingInterval BillingInterval
  intervalCount   Int             @default(1)
  isActive        Boolean         @default(true)
  displayOrder    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  limits             PlanFeatureLimit[]
  promotions         PromotionPlan[]
  subscriptions      BillingSubscription[]
  payments           BillingPayment[]
  priceHistory       PricingHistory[]
  generationPolicies GenerationPolicy[]

  @@index([isActive, displayOrder])
}

model FeatureDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  unitLabel   String   @default("uses") @db.VarChar(40)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  limits  PlanFeatureLimit[]
  buckets FeatureUsageBucket[]
  events  FeatureUsageEvent[]
}

model PlanFeatureLimit {
  id          String           @id @default(uuid()) @db.Uuid
  planId      String           @db.Uuid
  featureId   String           @db.Uuid
  resetPeriod UsageResetPeriod
  limit       Int?
  warningAt   Int              @default(80)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  plan    BillingPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId, resetPeriod])
  @@index([featureId, planId])
}

model Promotion {
  id                     String        @id @default(uuid()) @db.Uuid
  name                   String        @db.VarChar(120)
  code                   String?       @unique @db.VarChar(80)
  description            String?       @db.Text
  discountType           DiscountType
  discountValue          Int
  startsAt               DateTime
  endsAt                 DateTime
  timezone               String        @default("UTC") @db.VarChar(64)
  isActive               Boolean       @default(true)
  mode                   PromotionMode @default(AUTOMATIC)
  maximumRedemptions     Int?
  redemptionCount        Int           @default(0)
  perUserRedemptionLimit Int?
  newUsersOnly           Boolean       @default(false)
  minimumPurchase        Int?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  plans        PromotionPlan[]
  redemptions  PromotionRedemption[]
  payments     BillingPayment[]
  priceHistory PricingHistory[]

  @@index([isActive, mode, startsAt, endsAt])
}

model PromotionPlan {
  promotionId String      @db.Uuid
  planId      String      @db.Uuid
  promotion   Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  plan        BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([promotionId, planId])
}

model PromotionRedemption {
  id          String         @id @default(uuid()) @db.Uuid
  promotionId String         @db.Uuid
  userId      String         @db.Uuid
  paymentId   String         @unique @db.Uuid
  amount      Int
  createdAt   DateTime       @default(now())
  promotion   Promotion      @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment     BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([promotionId, userId, createdAt])
}

model FeatureUsageBucket {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  featureId   String              @db.Uuid
  resetPeriod UsageResetPeriod
  periodStart DateTime
  periodEnd   DateTime
  used        Int                 @default(0)
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature     FeatureDefinition   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  events      FeatureUsageEvent[]

  @@unique([userId, featureId, resetPeriod, periodStart])
  @@index([userId, periodEnd])
}

model FeatureUsageEvent {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  featureId  String             @db.Uuid
  bucketId   String             @db.Uuid
  requestKey String             @unique @db.VarChar(255)
  units      Int                @default(1)
  metadata   Json?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature    FeatureDefinition  @relation(fields: [featureId], references: [id], onDelete: Restrict)
  bucket     FeatureUsageBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  @@index([userId, featureId, createdAt])
}

model PricingHistory {
  id          String       @id @default(uuid()) @db.Uuid
  planId      String?      @db.Uuid
  promotionId String?      @db.Uuid
  actorId     String?      @db.Uuid
  changeType  String       @db.VarChar(80)
  before      Json?
  after       Json
  createdAt   DateTime     @default(now())
  plan        BillingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  promotion   Promotion?   @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
  @@index([promotionId, createdAt])
}

model DiscountCode {
  id                    String       @id @default(uuid()) @db.Uuid
  code                  String       @unique @db.VarChar(64)
  name                  String       @db.VarChar(120)
  description           String?      @db.VarChar(500)
  type                  DiscountType
  value                 Int
  maxDiscountAmount     Int?
  startsAt              DateTime
  endsAt                DateTime
  isActive              Boolean      @default(true)
  maxRedemptions        Int?
  maxRedemptionsPerUser Int          @default(1)
  redemptionCount       Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  payments BillingPayment[]

  @@index([isActive, startsAt, endsAt])
}

model BillingWebhookEvent {
  id              String               @id @default(uuid()) @db.Uuid
  provider        BillingProvider
  externalEventId String               @unique @db.VarChar(255)
  eventType       String               @db.VarChar(120)
  status          BillingWebhookStatus @default(RECEIVED)
  livemode        Boolean              @default(false)
  payloadHash     String               @db.VarChar(64)
  errorCode       String?              @db.VarChar(100)
  receivedAt      DateTime             @default(now())
  processedAt     DateTime?

  @@index([provider, eventType, receivedAt])
  @@index([status, receivedAt])
}

model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  actorId    String?         @db.Uuid
  action     AuditActionType
  targetType AuditTargetType
  targetId   String?         @db.Uuid
  metadata   Json?
  createdAt  DateTime        @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

enum ModelProvider {
  OPENAI
  GOOGLE
  ANTHROPIC
  MISTRAL
}

enum RoutingMode {
  AUTO
  MANUAL
  FALLBACK
}

enum GenerationStatus {
  RESERVED
  SUCCEEDED
  FAILED
  CANCELLED
  INTERRUPTED
}

model AIModel {
  creditCost Int @default(1)
  id               String             @id @default(uuid()) @db.Uuid
  provider         ModelProvider
  providerModelId  String             @db.VarChar(160)
  displayName      String             @db.VarChar(100)
  description      String             @default("") @db.VarChar(500)
  category         String             @default("general") @db.VarChar(40)
  capabilities     String[]           @default(["text"])
  enabled          Boolean            @default(false)
  manualAvailable  Boolean            @default(true)
  autoAvailable    Boolean            @default(false)
  maintenance      Boolean            @default(false)
  displayOrder     Int                @default(0)
  qualityTier      Int                @default(1)
  routingPriority  Int                @default(0)
  routingCostScore Decimal            @default(1) @db.Decimal(12, 6)
  inputPrice       Decimal            @db.Decimal(18, 8)
  cachedInputPrice Decimal            @db.Decimal(18, 8)
  outputPrice      Decimal            @db.Decimal(18, 8)
  additionalPrices Json               @default("{}")
  currency         String             @default("USD") @db.Char(3)
  maxContext       Int
  maxOutput        Int
  fallbackId       String?            @db.Uuid
  fallback         AIModel?           @relation("ModelFallback", fields: [fallbackId], references: [id], onDelete: SetNull)
  fallbackFor      AIModel[]          @relation("ModelFallback")
  effectiveFrom    DateTime           @default(now())
  effectiveUntil   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  policies         GenerationPolicy[]

  @@unique([provider, providerModelId])
  @@index([enabled, maintenance, displayOrder])
}

model GenerationPolicy {
  allowedFeatures    String[]    @default(["chat"])
  id                 String      @id @default(uuid()) @db.Uuid
  planId             String      @db.Uuid
  plan               BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  bucket             String      @db.VarChar(80)
  modelId            String?     @db.Uuid
  model              AIModel?    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  dailyLimit         Int
  monthlyLimit       Int
  maxInputChars      Int
  maxContext         Int
  maxOutput          Int
  maxFiles           Int
  maxFileBytes       Int
  maxDurationSeconds Int
  concurrency        Int
  ratePerMinute      Int
  enabled            Boolean     @default(true)
  routing            Json        @default("{}")
  updatedAt          DateTime    @updatedAt

  @@unique([planId, bucket])
}

model Conversation {
  projectId   String?      @db.Uuid
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String       @default("New conversation") @db.VarChar(160)
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  messages    Message[]
  attachments Attachment[]

  @@index([userId, archived, updatedAt])
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String           @db.VarChar(16)
  artifacts      Json             @default("[]")
  content        String           @default("") @db.Text
  modelName      String?          @db.VarChar(160)
  provider       ModelProvider?
  routingMode    RoutingMode?
  generationId   String?          @unique @db.Uuid
  status         GenerationStatus @default(SUCCEEDED)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model SavedPrompt {
  projectId String? @db.Uuid
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(160)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(200)
  mimeType       String       @db.VarChar(80)
  size           Int
  storageKey     String       @unique @db.VarChar(255)
  generated      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([userId, conversationId])
}

model UsageCounter {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket      String           @db.VarChar(80)
  periodStart DateTime
  period      UsageResetPeriod
  used        Int              @default(0)
  reserved    Int              @default(0)
  extra       Int              @default(0)

  @@unique([userId, bucket, period, periodStart])
}

model QuotaReservation {
  creditUnits Int @default(0)
  id          String           @id @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket      String           @db.VarChar(80)
  fingerprint String           @db.VarChar(64)
  dayStart    DateTime
  monthStart  DateTime
  status      GenerationStatus @default(RESERVED)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  finalizedAt DateTime?

  @@index([userId, status, expiresAt])
}

model UsageRecord {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestId         String           @db.Uuid
  subscriptionId    String?          @db.Uuid
  conversationId    String?          @db.Uuid
  messageId         String?          @db.Uuid
  provider          ModelProvider
  modelId           String           @db.Uuid
  providerModelId   String           @db.VarChar(160)
  modelName         String           @db.VarChar(160)
  routingMode       RoutingMode
  originalModelId   String?          @db.Uuid
  fallbackReason    String?          @db.VarChar(100)
  inputTokens       Int              @default(0)
  cachedInputTokens Int              @default(0)
  outputTokens      Int              @default(0)
  reasoningTokens   Int              @default(0)
  providerUsage     Json
  pricingSnapshot   Json
  estimatedCost     Decimal          @db.Decimal(18, 8)
  costEstimated     Boolean          @default(false)
  currency          String           @db.Char(3)
  latencyMs         Int
  status            GenerationStatus
  errorCategory     String?          @db.VarChar(100)
  createdAt         DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([requestId])
  @@index([modelId, createdAt])
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(160)
  instructions String @default("") @db.Text
  context String @default("") @db.Text
  preferredModelId String? @db.Uuid
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversations Conversation[]
  prompts SavedPrompt[]
  workflows Workflow[]
  @@index([userId, archived, updatedAt])
}

model Workflow {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String @db.VarChar(160)
  steps Json
  enabled Boolean @default(true)
  trigger Json @default("{\"type\":\"manual\"}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs WorkflowRun[]
  @@index([projectId, updatedAt])
}

model WorkflowRun {
  id String @id @db.Uuid
  workflowId String @db.Uuid
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  conversationId String @db.Uuid
  fingerprint String @db.VarChar(64)
  steps Json
  status GenerationStatus @default(RESERVED)
  completedSteps Int @default(0)
  error String? @db.VarChar(500)
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  @@index([workflowId, status])
}

model EconomicEntry {
  id String @id @db.Uuid
  kind String @db.VarChar(32)
  amount Decimal @db.Decimal(18, 8)
  currency String @db.Char(3)
  requestId String? @db.Uuid
  note String @db.VarChar(500)
  actorId String @db.Uuid
  createdAt DateTime @default(now())
  @@index([currency, createdAt])
}
