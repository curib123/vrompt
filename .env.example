# shared
NODE_ENV=development

# web
NEXT_PUBLIC_APP_NAME=Vrompt
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
INTERNAL_API_BASE_URL=http://vrompt-api:4000/api/v1

# api
PORT=4000
API_PREFIX=api/v1
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrompt
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
MEDIA_STORAGE_PROVIDER=LOCAL
MEDIA_STORAGE_LOCAL_DIR=./storage
MEDIA_STORAGE_LOCAL_PUBLIC_URL=/media
