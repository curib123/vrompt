# shared
NODE_ENV=development

# web
NEXT_PUBLIC_APP_NAME=Vrompt
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
INTERNAL_API_BASE_URL=http://vrompt-api:4000/api/v1

# api
PORT=4000
API_PREFIX=api/v1
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrompt
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
AI_API_BASE_URL=https://api.openai.com/v1
# Required to enable generation; never expose this key to the web app.
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT_MS=60000
AI_PUBLIC_GUEST_DAILY_LIMIT=3
AI_PUBLIC_FREE_DAILY_LIMIT=10
AI_PUBLIC_PREMIUM_DAILY_LIMIT=100
AI_INTERNAL_DAILY_LIMIT=50
AI_MAX_OUTPUT_TOKENS=1600
AI_RATE_LIMIT_PER_MINUTE=5
AI_CONTENT_GAP_THRESHOLD=3
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=test
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
PAYMONGO_PRO_PRICE_CENTAVOS=29900
PAYMONGO_PRO_PERIOD_DAYS=30
PAYMONGO_CHECKOUT_EXPIRY_HOURS=24
PAYMONGO_CHECKOUT_RATE_LIMIT_PER_HOUR=5
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URL in the same Google OAuth Web client.
# Do not add a trailing slash or use the frontend URL here.
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register this exact URL in the same GitHub OAuth App.
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# Staff control-panel accounts. Set unique 12+ character passwords before deployment.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
MODERATOR_BOOTSTRAP_EMAIL=
MODERATOR_BOOTSTRAP_USERNAME=
MODERATOR_BOOTSTRAP_PASSWORD=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
MEDIA_STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=./storage/evidence
MEDIA_STORAGE_LOCAL_PUBLIC_URL=/media
