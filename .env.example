# shared
NODE_ENV=development

# web
NEXT_PUBLIC_APP_NAME=Vrompt
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100/api/v1
INTERNAL_API_BASE_URL=http://vrompt-api:4000/api/v1

# api
PORT=4000
API_PREFIX=api/v1
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrompt
REDIS_URL=redis://localhost:6379
ORACLE_HOST=
ORACLE_PORT=22
VROMPT_DOMAIN=
VROMPT_PUBLIC_URL=
WEB_ORIGIN=http://localhost:3100
# Provider credentials stay server-side. Configure models and limits in the admin workspace.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
CHAT_STORAGE_DIR=./private-chat-files
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=test
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
PAYMONGO_PRO_PRICE_CENTAVOS=599
PAYMONGO_PRO_PERIOD_DAYS=30
PAYMONGO_CHECKOUT_EXPIRY_HOURS=24
PAYMONGO_CHECKOUT_RATE_LIMIT_PER_HOUR=5
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URL in the same Google OAuth Web client.
# Do not add a trailing slash or use the frontend URL here.
GOOGLE_CALLBACK_URL=http://localhost:4100/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register this exact URL in the same GitHub OAuth App.
GITHUB_CALLBACK_URL=http://localhost:4100/api/v1/auth/github/callback

# Staff control-panel accounts. Set unique 12+ character passwords before deployment.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
MEDIA_STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=./storage/evidence
MEDIA_STORAGE_LOCAL_PUBLIC_URL=/media
