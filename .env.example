# shared
NODE_ENV=development

# web
NEXT_PUBLIC_APP_NAME=Vrompt
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
INTERNAL_API_BASE_URL=http://vrompt-api:4000/api/v1

# api
PORT=4000
API_PREFIX=api/v1
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vrompt
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URL in the same Google OAuth Web client.
# Do not add a trailing slash or use the frontend URL here.
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register this exact URL in the same GitHub OAuth App.
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
MEDIA_STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=./storage/evidence
MEDIA_STORAGE_LOCAL_PUBLIC_URL=/media
